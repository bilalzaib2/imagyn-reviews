# Copy to .env and fill in real values. Never commit .env — it's gitignored.
# This file documents every environment variable the app actually reads (verified against
# the codebase, not assumed) and which are required vs. optional-with-a-default.

# --- Required — Shopify app credentials (from the Partner Dashboard) ---
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SCOPES=write_products,write_metaobjects,write_metaobject_definitions,write_files,read_files
SHOPIFY_APP_URL=

# Optional — only needed if serving the storefront/app proxy from a custom domain instead of
# the default *.myshopify.com one (see app/shopify.server.ts).
SHOP_CUSTOM_DOMAIN=

# --- Required — database (Prisma reads this directly via prisma/schema.prisma) ---
# IMPORTANT: use a genuinely separate database for local development, never the production
# Railway connection string. `shopify app dev` and `npm run db:seed` both write real rows
# through whatever DATABASE_URL is set here — if it points at production, that's real
# merchants' data, not a sandbox. Provision a free/local Postgres instead (either a second,
# separate Railway Postgres service, or `docker run -p 5432:5432 -e POSTGRES_PASSWORD=dev
# postgres`), run `prisma migrate deploy` against it once, and point this at that. See
# DATABASE_SAFETY.md for the full policy and prisma/seed.js's own hard runtime guard.
DATABASE_URL=

# --- Required for real review-request/reminder emails to send ---
# Get from https://resend.com — API key + a verified sending domain.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
# Required only to receive delivered/opened/bounced status updates via webhook — sending
# itself works without this. Create the webhook endpoint in Resend's dashboard pointing at
# <SHOPIFY_APP_URL>/webhooks/resend, then paste the signing secret Resend generates here.
RESEND_WEBHOOK_SECRET=
# Optional — only "resend" is implemented today (app/services/notifications/provider.server.ts).
EMAIL_PROVIDER=resend

# --- Required for AI Review Summaries to generate ---
# Optional — selects the provider; defaults to "openai" if unset. "anthropic" and "gemini"
# are also implemented (app/services/ai/provider.server.ts) but untested against this app's
# actual production traffic — openai is the one this app has been verified against.
AI_PROVIDER=openai
OPENAI_API_KEY=
# Optional — defaults to gpt-4o-mini (app/services/ai/openai.server.ts).
OPENAI_MODEL=
# Only used if AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
# Only used if AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=
# Optional — how many new approved reviews must accumulate before an AI summary
# auto-regenerates; defaults to 5 (app/services/aiSummary.server.ts).
AI_SUMMARY_REGENERATION_THRESHOLD=

# --- Optional — media storage for video/photo reviews ---
# Defaults to "shopify" (reuses the app's own Admin GraphQL session, no extra credential
# needed) — see app/services/storage/provider.server.ts. Only set this if switching providers.
STORAGE_PROVIDER=shopify

# --- Set automatically by the platform — do not set manually in most cases ---
NODE_ENV=
