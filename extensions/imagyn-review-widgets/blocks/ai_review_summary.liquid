{{ 'imagyn-tokens.css' | asset_url | stylesheet_tag }}
{{ 'imagyn-typography.css' | asset_url | stylesheet_tag }}
{{ 'imagyn-component-ratings-section.css' | asset_url | stylesheet_tag }}
{{ 'imagyn-component-summary.css' | asset_url | stylesheet_tag }}

<div
  class="imagyn-ai-summary-block"
  data-imagyn-ai-summary-block
  data-product-id="{{ product.id }}"
  hidden
></div>

{% comment %}
  `defer` (not the blocking script_tag filter) — theme-check flags parser-blocking
  scripts; both stay in document order so imagyn-appearance.js still finishes applying
  tokens before ai-review-summary.js reads them (deferred scripts run in source order).
{% endcomment %}
<script src="{{ 'imagyn-appearance.js' | asset_url }}" defer></script>
<script src="{{ 'ai-review-summary.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "AI Review Summary",
  "target": "section",
  "settings": [
    {
      "type": "paragraph",
      "content": "Shows the AI-generated summary for this product, wherever you place this block on the product page — independent of the main Reviews widget. Renders nothing until you've generated a summary for this product in Imagyn Reviews (Products > AI Summary)."
    }
  ]
}
{% endschema %}
