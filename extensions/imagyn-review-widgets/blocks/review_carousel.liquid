{% comment %}
  Store-wide (not per-product) — real approved reviews across the whole catalog, sourced
  from app/routes/api.reviews.featured.tsx (never fabricated). Colors/typography/card style
  come from the same centralized Appearance System (Brand Studio) every other Imagyn widget
  on this storefront already uses — this block's own schema only carries structural/
  behavioral settings (heading, layout, which fields to show, navigation), never a
  competing color/style system. Section-level spacing is Shopify's own native "Apps"
  section wrapper setting ("Make section margins the same as theme"), not duplicated here.

  data-product-id below is present (a real Shopify product ID) only when this block instance
  happens to render on a product page — Liquid's global `product` object is only non-null
  there, regardless of block type. review-carousel.js uses this to decide whether the AI
  summary it fetches should be this product's own (see api.reviews.featured.tsx's productId
  param) or the store-wide one — the "product vs store context" the Review Carousel needs
  without a separate, third AI summary type.
{% endcomment %}
<div
  class="imagyn-carousel imagyn-carousel--align-{{ block.settings.text_align }}"
  data-imagyn-carousel
  data-heading="{{ block.settings.heading }}"
  data-review-count="{{ block.settings.review_count }}"
  data-show-summary="{{ block.settings.show_summary }}"
  data-product-id="{{ product.id }}"
  data-show-ai-summary="{{ block.settings.show_ai_summary }}"
  data-cards-mobile="{{ block.settings.cards_mobile }}"
  data-review-length="{{ block.settings.review_length }}"
  data-text-size="{{ block.settings.text_size }}"
  data-no-image-fallback="{{ block.settings.no_image_fallback }}"
  data-show-rating="{{ block.settings.show_rating }}"
  data-show-date="{{ block.settings.show_date }}"
  data-show-name="{{ block.settings.show_name }}"
  data-show-images="{{ block.settings.show_images }}"
  data-show-video="{{ block.settings.show_video }}"
  data-show-product="{{ block.settings.show_product }}"
  data-show-arrows="{{ block.settings.show_arrows }}"
  data-show-dots="{{ block.settings.show_dots }}"
  data-autoplay="{{ block.settings.autoplay }}"
  data-autoplay-speed="{{ block.settings.autoplay_speed }}"
  style="--imagyn-carousel-cards-desktop: {{ block.settings.cards_desktop }}; --imagyn-carousel-cards-tablet: {{ block.settings.cards_tablet }}; --imagyn-carousel-cards-mobile: {{ block.settings.cards_mobile }}; --imagyn-carousel-gap: {{ block.settings.card_spacing }}px; --imagyn-carousel-content-gap: {{ block.settings.content_spacing }}px; --imagyn-carousel-image-ratio: {{ block.settings.image_ratio | replace: ':', ' / ' }};"
>
  <div class="imagyn-carousel__viewport" data-imagyn-carousel-viewport>
    <ul class="imagyn-carousel__track" data-imagyn-carousel-track></ul>
  </div>
  <div class="imagyn-carousel__controls" data-imagyn-carousel-controls></div>
  <div class="imagyn-carousel__dots" data-imagyn-carousel-dots></div>
</div>

<script src="{{ 'imagyn-appearance.js' | asset_url }}" defer></script>
<script src="{{ 'review-carousel.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Review Carousel",
  "target": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "What customers are saying" },
    { "type": "range", "id": "review_count", "label": "Maximum reviews to show", "min": 3, "max": 24, "step": 1, "default": 12 },
    { "type": "checkbox", "id": "show_summary", "label": "Show overall rating summary", "info": "The store's real average rating and review count, shown above the cards.", "default": true },
    {
      "type": "checkbox",
      "id": "show_ai_summary",
      "label": "Show AI Summary",
      "default": true,
      "info": "On a product page, shows that product's own AI summary; elsewhere, shows your store-wide AI summary. Requires AI Review Summaries to be enabled for the Review Carousel in Settings > Growth > Google, SEO & AI."
    },
    { "type": "header", "content": "Layout" },
    { "type": "range", "id": "cards_desktop", "label": "Cards visible on desktop", "min": 2, "max": 5, "step": 1, "default": 3 },
    { "type": "range", "id": "cards_tablet", "label": "Cards visible on tablet", "min": 1, "max": 3, "step": 1, "default": 2 },
    {
      "type": "select",
      "id": "cards_mobile",
      "label": "Cards visible on mobile",
      "options": [
        { "value": "1", "label": "1" },
        { "value": "2", "label": "2" }
      ],
      "default": "1"
    },
    { "type": "range", "id": "card_spacing", "label": "Spacing between cards", "min": 8, "max": 32, "step": 2, "unit": "px", "default": 16 },
    { "type": "range", "id": "content_spacing", "label": "Spacing inside card", "info": "Space between the review text, rating, customer, and product rows.", "min": 4, "max": 24, "step": 1, "unit": "px", "default": 10 },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Image ratio",
      "options": [
        { "value": "4:3", "label": "4:3" },
        { "value": "1:1", "label": "1:1" },
        { "value": "3:4", "label": "3:4" }
      ],
      "default": "1:1"
    },
    { "type": "header", "content": "Alignment" },
    {
      "type": "select",
      "id": "text_align",
      "label": "Text alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    },
    { "type": "header", "content": "Card content" },
    { "type": "checkbox", "id": "show_rating", "label": "Show star rating", "default": true },
    { "type": "checkbox", "id": "show_date", "label": "Show review date", "default": true },
    { "type": "checkbox", "id": "show_name", "label": "Show customer name", "default": true },
    { "type": "checkbox", "id": "show_images", "label": "Show review photos", "default": true },
    { "type": "checkbox", "id": "show_video", "label": "Show review videos", "default": true },
    { "type": "checkbox", "id": "show_product", "label": "Show product info", "default": true },
    { "type": "header", "content": "Content" },
    {
      "type": "select",
      "id": "review_length",
      "label": "Review length",
      "options": [
        { "value": "small", "label": "Small" },
        { "value": "medium", "label": "Medium" },
        { "value": "large", "label": "Large" }
      ],
      "default": "medium"
    },
    {
      "type": "select",
      "id": "text_size",
      "label": "Text size",
      "options": [
        { "value": "small", "label": "Small" },
        { "value": "medium", "label": "Medium" },
        { "value": "large", "label": "Large" }
      ],
      "default": "medium"
    },
    {
      "type": "select",
      "id": "no_image_fallback",
      "label": "No image fallback",
      "info": "What to do with a real review that has no photo or video.",
      "options": [
        { "value": "text", "label": "Show review text only" },
        { "value": "hide", "label": "Hide from this carousel" }
      ],
      "default": "text"
    },
    { "type": "header", "content": "Navigation" },
    { "type": "checkbox", "id": "show_arrows", "label": "Show navigation arrows", "default": true },
    { "type": "checkbox", "id": "show_dots", "label": "Show pagination dots", "default": false },
    { "type": "checkbox", "id": "autoplay", "label": "Autoplay", "default": true },
    { "type": "range", "id": "autoplay_speed", "label": "Autoplay speed (seconds)", "min": 3, "max": 10, "step": 1, "default": 5 }
  ]
}
{% endschema %}
