// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

// Note that some adapters may set a maximum length for the String type by default, please ensure your strings are long
// enough when changing adapters.
// See https://www.prisma.io/docs/orm/reference/prisma-schema-reference#string for more information
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Session {
  id                  String    @id
  shop                String
  state               String
  isOnline            Boolean   @default(false)
  scope               String?
  expires             DateTime?
  accessToken         String
  userId              BigInt?
  firstName           String?
  lastName            String?
  email               String?
  accountOwner        Boolean   @default(false)
  locale              String?
  collaborator        Boolean?  @default(false)
  emailVerified      Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

model Store {
  id           String          @id @default(cuid())
  name         String
  slug         String          @unique
  domain       String?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  products     Product[]
  reviews      Review[]
  reviewRequests ReviewRequest[]
  widgets      Widget[]
  appearances  Appearance[]
  emailTemplates EmailTemplate[]
  achievements Achievement[]
  emailSuppressions EmailSuppression[]

  // Order-lifecycle automation settings (see review-request.server.ts's createFromOrder and
  // webhooks.fulfillments.create.tsx). autoRequestTrigger is a plain string, not an enum, so
  // future trigger types (e.g. "delivery") are a config addition, not a schema change.
  autoRequestEnabled   Boolean @default(false)
  autoRequestDelayDays Int     @default(7)
  autoRequestTrigger   String  @default("fulfillment")

  // Automatic Reminder Emails (see reviewRequestScheduler.server.ts's runDueReminderSweep).
  // Off by default for every store, existing or new — turning this on never resurrects a
  // backlog of old requests. remindersEnabledAt is the eligibility cutoff a sweep compares
  // each ReviewRequest.sentAt against (only requests sent at/after this timestamp are ever
  // considered); it's bumped forward only on an off->on transition (see
  // store.server.ts's updateReminderSettings), never on a resave while already on, so
  // re-enabling after a period of being off starts the cutoff fresh rather than resurrecting
  // whatever accumulated while off.
  reminderEmailsEnabled Boolean   @default(false)
  remindersEnabledAt    DateTime?

  // Shopify Billing (see app/services/billing/). This is a local cache of Shopify's own
  // billing state — kept in sync by the app_subscriptions/update webhook and by the billing
  // page's own live syncBillingFromShopify() call (a raw GraphQL query, not the SDK's
  // billing.check() wrapper — see that function's own comment for why) — so the
  // access-control gate in app.tsx doesn't need a live Admin API round-trip on every page
  // load. Shopify's Admin API remains the source of truth; this table can always be rebuilt.
  // plan: "starter" | "growth" | "scale" | "owner" (see app/services/permissions.ts —
  // "owner" is a hidden, non-billable plan for internally-owned stores, granted every
  // permission with no Shopify subscription). planStatus values actually stored: "pending"
  // (never explicitly chosen a plan yet, including Starter — free but still an explicit
  // choice on the billing page), "active", "trialing", "frozen". Shopify subscription states
  // of CANCELLED/DECLINED/EXPIRED are not stored verbatim — syncBillingFromShopify collapses
  // all of them to plan: "starter", planStatus: "active" rather than a dead-end status, so
  // access-control (app.tsx's gate) only ever needs to check for "active"/"trialing" (plus
  // the isDevelopmentStore/plan==="owner" bypasses — see getBillingSnapshot).
  plan                 String    @default("starter")
  planStatus           String    @default("pending")
  shopifySubscriptionId String?
  trialEndsAt          DateTime?
  // Computed once via Admin GraphQL (shop.plan.partnerDevelopment) and cached — a store's
  // development status essentially never changes in practice, so this avoids a live check on
  // every request. Development stores always bypass billing entirely (see billing.server.ts).
  isDevelopmentStore   Boolean?

  // Moderation Rules (see app/services/moderationRules.server.ts) — automatic screening for
  // new customer-submitted reviews, applied in the submission pipeline (api.reviews.tsx,
  // r.$token.tsx) before a review row is even created. Off by default so an existing store's
  // all-manual moderation behavior never changes until a merchant explicitly opts in.
  moderationRulesEnabled    Boolean @default(false)
  moderationMinRating       Int     @default(4)
  moderationRequireVerified Boolean @default(false)
  moderationHoldLinks       Boolean @default(true)
  moderationHoldProfanity   Boolean @default(true)
  // Merchant-entered, one phrase per line — parsed by moderationRules.server.ts's
  // parseBannedWords, not stored as a separate table since it's always read/written as one
  // whole list, never queried per-word.
  moderationBannedWords     String  @default("")
  moderationNotifyOnHold    Boolean @default(false)
  moderationNotifyEmail     String?

  // Full-catalog product sync progress (see product.server.ts's syncAllProducts and
  // productSync.server.ts's runProductSync). One row per store — only one sync runs at a
  // time per store, so this doesn't need its own table. status: "idle" | "running" |
  // "completed" | "failed". `productSyncTotal` is informational only (from Shopify's
  // productsCount, which Shopify itself may report as an approximation above ~10k products);
  // `productSyncSynced`/`productSyncFailed` are exact, since this app incremented them itself
  // for every product it actually upserted. Gating the Judge.me importer on this (only once
  // status is "completed") is planned but not yet wired up — deliberately out of scope here.
  productSyncStatus     String    @default("idle")
  productSyncTotal      Int?
  productSyncSynced     Int       @default(0)
  productSyncFailed     Int       @default(0)
  productSyncStartedAt  DateTime?
  productSyncFinishedAt DateTime?
  productSyncError      String?

  // Review Rewards (see app/services/rewards.server.ts) — conditions checked once a review
  // is approved: rewardMinRating/rewardRequireVerified/rewardRequirePhoto/rewardRequireVideo
  // are all evaluated against attributes the Review row already has, nothing new is inferred.
  // valueType/value describe the Shopify discount created on issuance ("percentage" values
  // are a whole-number percent, "fixed_amount" values are the store's currency amount).
  rewardsEnabled        Boolean @default(false)
  rewardValueType       String  @default("percentage")
  rewardValue           Float   @default(10)
  rewardMinRating       Int     @default(4)
  rewardRequireVerified Boolean @default(true)
  rewardRequirePhoto    Boolean @default(false)
  rewardRequireVideo    Boolean @default(false)

  rewards Reward[]
}

model Product {
  id               String   @id @default(cuid())

  storeId          String
  store            Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)

  shopifyProductId String? @unique
  name             String
  handle           String?
  vendor           String?
  productType      String?
  status           String?
  featuredImage    String?
  slug             String?
  description      String?

  // Denormalized review statistics, recalculated by review.server.ts after every review mutation.
  averageRating    Float    @default(0)
  totalReviews     Int      @default(0)
  rating5Count     Int      @default(0)
  rating4Count     Int      @default(0)
  rating3Count     Int      @default(0)
  rating2Count     Int      @default(0)
  rating1Count     Int      @default(0)

  // Set only by product.server.ts's syncProducts, kept separate from updatedAt so review-stat
  // recalculation (which also touches this row) can't make "last synced" look fresher than it is.
  lastSyncedAt     DateTime?

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  reviews          Review[]
  reviewRequests   ReviewRequest[]
  widgets          Widget[]
  aiSummary        ProductAiSummary?
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

model Review {
  id               String       @id @default(cuid())

  storeId          String
  store            Store        @relation(fields: [storeId], references: [id], onDelete: Cascade)

  productId        String
  product          Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  productTitle     String?

  rating           Int
  title            String?
  content          String

  reviewerName     String
  reviewerEmail    String?
  reviewerLocation String?
  verifiedPurchase Boolean      @default(false)

  status           ReviewStatus @default(PENDING)
  isPublished      Boolean      @default(false)
  helpfulCount     Int          @default(0)
  notHelpfulCount  Int          @default(0)
  featured         Boolean      @default(false)

  reply            String?
  repliedAt        DateTime?

  photoUrls        String?
  deletedAt        DateTime?

  // Set once, at creation, by the Moderation Rules pipeline (see
  // app/services/moderationRules.server.ts) — never updated afterward, even if a merchant
  // later manually approves/rejects the review, so this always answers "how did this review
  // originally get its first status," not "what is its status now."
  moderationStatus String?
  moderationReason String?

  // The imported review's stable ID on its source platform (Judge.me's export calls this
  // `metaobject_handle` — a UUID-based handle, not a plain integer, but stable and unique per
  // review) — see reviewImportExport.server.ts's isDuplicate. Nullable: customer-submitted
  // reviews and any import source that genuinely has no stable ID never set this, and fall
  // back to content-based duplicate detection. Not a hard DB unique constraint — duplicate
  // prevention is an application-level check-before-create (see isDuplicate), same as the
  // rest of this pipeline, so a constraint violation is never a code path this app relies on.
  externalId       String?

  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  helpfulVotes     ReviewHelpfulVote[]
  media            ReviewMedia[]
  reward           Reward?

  @@index([deletedAt, createdAt])
  @@index([storeId, deletedAt, createdAt])
  @@index([productId, deletedAt])
  @@index([status])
  @@index([rating])
  @@index([verifiedPurchase])
  @@index([featured])
  @@index([helpfulCount])
  @@index([storeId, externalId])
}

// One row per review that was ever *evaluated* for a reward (not just the ones that
// succeeded) — see app/services/rewards.server.ts's evaluateAndIssueReward. reviewId is
// unique so the database itself enforces "at most one reward per review," the actual
// duplicate-prevention mechanism (not just an application-level check-before-create).
// status: "pending" (evaluated, not yet attempted — practically transient) | "issued" |
// "failed" | "ineligible". A row is written even for "ineligible" reviews specifically so a
// later re-evaluation (e.g. a merchant enabling Rewards after reviews already existed) never
// re-issues for a review that was already correctly judged ineligible under the rules active
// at the time.
model Reward {
  id       String @id @default(cuid())

  storeId  String
  store    Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  reviewId String @unique
  review   Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  status String
  reason String?

  valueType String
  value     Float

  // Set only once status becomes "issued" — a real Shopify discount code (discountCodeBasicCreate),
  // never fabricated or displayed before the mutation actually succeeds.
  discountCode      String?
  shopifyDiscountId String?

  issuedAt  DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([storeId])
  @@index([status])
}

enum ReviewMediaType {
  IMAGE
  VIDEO
}

// Customer-uploaded photos (and, later, videos — the type column and enum already support
// VIDEO so that can be turned on without a schema change) attached to a review. One row per
// asset rather than a delimited string (contrast the older, unused Review.photoUrls) so each
// item carries its own moderation lifecycle (independently deletable) and real dimensions for
// aspect-ratio-safe rendering, instead of just a bare URL.
model ReviewMedia {
  id           String          @id @default(cuid())

  reviewId     String
  review       Review          @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  type         ReviewMediaType @default(IMAGE)
  url          String
  width        Int?
  height       Int?
  thumbnailUrl String?

  createdAt    DateTime        @default(now())

  @@index([reviewId])
}

enum HelpfulVoteValue {
  HELPFUL
  NOT_HELPFUL
}

// One row per (review, visitor) — the unique constraint is what makes "exactly one vote
// per visitor, can change their vote" an invariant enforced by the database itself, not
// just application logic. visitorId is an opaque string: a client-generated anonymous id
// for storefront shoppers (see reviews-widget.js) today, but nothing here assumes that —
// a real customer id would work identically, so this doesn't need to change if/when the
// storefront gains real customer auth.
model ReviewHelpfulVote {
  id         String           @id @default(cuid())

  reviewId   String
  review     Review           @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  visitorId  String
  vote       HelpfulVoteValue

  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  @@unique([reviewId, visitorId])
  @@index([reviewId, vote])
}

// One cached summary per product, generated from that product's APPROVED reviews by
// whichever AiProvider is currently configured (see app/services/ai/) — never generated
// on a storefront page view (see aiSummary.server.ts's getAiSummary, a pure cache read).
// positives/negatives are stored as JSON-encoded string arrays, the same pattern
// Widget.settings already uses for structured data in this schema.
model ProductAiSummary {
  id              String   @id @default(cuid())

  productId       String   @unique
  product         Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  summary         String
  positives       String
  negatives       String
  recommendation  String

  reviewCountUsed Int
  provider        String
  modelUsed       String

  generatedAt     DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model ReviewRequest {
  id           String          @id @default(cuid())
  storeId      String
  store        Store           @relation(fields: [storeId], references: [id], onDelete: Cascade)
  productId    String?
  product      Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  email        String?
  name         String?
  orderNumber  String?
  customMessage String?
  requestToken String?         @unique
  // Extension seam for link security (README: expiration, single-use validation, fraud
  // protection) — a single opaque token + these two timestamps is enough for the MVP
  // resolver (app/routes/r.$token.tsx) to enforce both without a separate token table.
  // A dedicated ReviewRequestToken model only earns its keep once a request can have
  // *multiple* concurrent tokens (e.g. reminder emails each with their own link) — that's
  // explicitly future work, not this pass.
  tokenExpiresAt DateTime?
  tokenUsedAt    DateTime?
  delayDays    Int?
  scheduledFor DateTime?
  status       String          @default("pending")
  sentAt       DateTime?
  openedAt     DateTime?
  reviewedAt   DateTime?

  // Order-lifecycle linkage (see webhooks.fulfillments.create.tsx and
  // review-request.server.ts's createFromOrder). Both null for manually-created requests —
  // the unique constraint below only fires for order-triggered ones, so merchants can still
  // freely create manual requests for the same product without colliding with it.
  shopifyOrderId    String?
  shopifyLineItemId String?
  // "manual" | "order" — which flow created this row, surfaced in the admin UI.
  source            String    @default("manual")
  // Bounded retry count for dispatchRequestEmail — see MAX_SEND_ATTEMPTS in
  // review-request.server.ts. Never incremented past that constant.
  sendAttempts      Int       @default(0)

  // Automatic Reminder Emails — set once each reminder actually sends (dispatchReminderEmail
  // in review-request.server.ts), independently of `status`/`sentAt` above, which track only
  // the original Day-0 request's own lifecycle. Both fixed-day reminders are computed from
  // `sentAt` directly (Day 3 / Day 7), not chained off each other, matching the product spec.
  // Null on every existing row by default — reminders were never sent for historical requests,
  // which is the correct, safe starting state (see Store.remindersEnabledAt for why old
  // requests are also never retroactively eligible).
  reminder1SentAt     DateTime?
  reminderFinalSentAt DateTime?

  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@unique([shopifyOrderId, productId])
  @@index([status])
  @@index([scheduledFor])
  // Every admin-facing query (reviewRequestService.listRequests) filters by storeId first —
  // this was the one access pattern with no storeId-prefixed index at all (contrast Review's
  // own storeId-prefixed indexes above), invisible at today's volume but a genuine scaling
  // risk since a request lands here on every fulfilled order line item.
  @@index([storeId, status, createdAt])
}

model Widget {
  id           String          @id @default(cuid())
  storeId      String
  store        Store           @relation(fields: [storeId], references: [id], onDelete: Cascade)
  productId    String?
  product      Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  name         String
  type         String          @default("review")
  settings     String?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
}

// The centralized, store-wide design-token system every storefront widget (Product
// Reviews, Product Rating Badge, Collection Rating Badge, and future ones) consumes —
// see app/services/appearance.shared.ts for the token contract and
// docs/STOREFRONT_DESIGN_SYSTEM.md for the underlying --imagyn-* CSS custom properties
// these tokens resolve onto. Deliberately store-wide (no productId), unlike Widget:
// the whole point is one shared source of truth, not per-widget-type duplication.
//
// Multiple rows per store are allowed (only one isActive) rather than a hard singleton,
// so "Saved Presets"/"Brand Themes" (both documented future work) are additive later —
// more rows, isActive toggled — with no schema change.
model Appearance {
  id           String          @id @default(cuid())
  storeId      String
  store        Store           @relation(fields: [storeId], references: [id], onDelete: Cascade)

  name         String          @default("Default")
  // "minimal" | "modern" | "editorial" | "classic" | "custom" — see
  // app/services/appearance.presets.ts. Only "custom" is functional today.
  preset       String          @default("custom")
  // Exactly one true per store; enforced in appearance.server.ts (not a DB constraint —
  // see that file for why), same application-level-enforcement convention already used
  // for widget resolution in widget.server.ts.
  isActive     Boolean         @default(true)

  // JSON-encoded AppearanceTokens (appearance.shared.ts) — same JSON-as-String precedent
  // as Widget.settings, so the token contract can grow without a migration per field.
  tokens       String

  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@index([storeId, isActive])
}

// Email Studio — merchant-editable content for outbound review-request emails. Same shape as
// Appearance above: one active row per (store, type), JSON-encoded content so the contract
// (email.shared.ts's EmailTemplateContent) can grow without a migration per field. Reading
// this is fully optional for every sender — review-request.server.ts falls back to today's
// hardcoded defaults when no active row exists, so an un-configured store's emails are
// byte-for-byte what they were before this model existed.
model EmailTemplate {
  id           String          @id @default(cuid())
  storeId      String
  store        Store           @relation(fields: [storeId], references: [id], onDelete: Cascade)

  name         String          @default("Default")
  // "review_request" (every plan), "reminder_1" / "reminder_final" (Pro-only, gated by
  // canUseEmailReminders — see email.shared.ts's EmailTemplateType and
  // reviewRequestScheduler.server.ts's runDueReminderSweep). Same "additive rows" pattern
  // Appearance already established above — a new type is a new row, never a migration.
  type         String          @default("review_request")
  // Exactly one true per (store, type); enforced in emailTemplate.server.ts, not a DB
  // constraint — same application-level-enforcement convention as Appearance/Widget.
  isActive     Boolean         @default(true)

  // JSON-encoded EmailTemplateContent (email.shared.ts) — subject/heading/body/button text,
  // accent color, logo URL.
  content      String

  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@index([storeId, type, isActive])
}

// Medals/Achievements — see app/services/achievements.server.ts. One row per (store, key)
// once a milestone-style medal is genuinely earned (real, storeId-scoped data crossed the
// threshold) — this is a ledger of "this happened," not a settings table, so it's never
// written to from client input. Only medals whose definition has `persistent: true` in
// achievements.shared.ts get a row here; a live/current-status medal (e.g. Trending) is
// recomputed on every read and never persisted, since claiming a permanent badge for an
// inherently time-bound signal would misrepresent it. Once written, a row is never deleted
// or "un-earned" if the underlying metric later dips — the achievement genuinely happened.
model Achievement {
  id        String   @id @default(cuid())
  storeId   String
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)

  // Stable key from achievements.shared.ts's ACHIEVEMENT_DEFINITIONS, e.g.
  // "verified_reviews_100" — never a display name, so renaming a medal in the UI later never
  // requires a data migration.
  key       String

  // The real, derived date this was earned — never "now" unless that IS the accurate
  // detection date for that specific medal (see achievements.server.ts's per-family comments
  // for which medals can derive an exact historical date vs. only a first-detected date).
  earnedAt  DateTime

  // JSON snapshot of the stats at the moment this was earned (e.g. { count: 100 } or
  // { percentile: 10, storesConsidered: 42 }) — for display richness only ("earned at 100
  // verified reviews"), never re-derived from this column.
  metadata  String?

  createdAt DateTime @default(now())

  @@unique([storeId, key])
  @@index([storeId])
}

// Email unsubscribe/suppression — one row per (store, email) that has opted out, checked by
// dispatchRequestEmail/dispatchReminderEmail (review-request.server.ts) before every automated
// send, including the Day-0 review request itself and both reminders, and enforced regardless
// of trigger (scheduled sweep or a merchant's manual Send Now/Resend). Deliberately keyed by
// (store, email) rather than by ReviewRequest — a customer can have multiple review requests
// across different orders/products over time, and an unsubscribe must stop all of them, not
// just the one whose email happened to carry the link (see emailSuppression.server.ts). No
// admin UI reads this in V1 — it exists so the backend enforces suppression correctly and is
// ready for a future admin/support view, not because one is being built now.
model EmailSuppression {
  id           String   @id @default(cuid())
  storeId      String
  store        Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)

  // Always lower-cased/trimmed before storage or lookup — see emailSuppression.server.ts's
  // normalizeEmail — so a differently-cased resend of the same address can't bypass suppression.
  email        String

  suppressedAt DateTime @default(now())
  // Extension seam (mirrors ReviewRequest.source's convention) — every row today is
  // "unsubscribe_link"; a future suppression source (e.g. a hard bounce) is a new value here,
  // not a schema change.
  source       String   @default("unsubscribe_link")

  @@unique([storeId, email])
  @@index([storeId, email])
}
